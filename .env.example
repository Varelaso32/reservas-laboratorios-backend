# Copia este archivo como .env y pon tus valores. El .env NO se sube al repositorio.
#
# Credenciales de PostgreSQL. Las usan el contenedor "db" del compose y la API.
# Si ya tenías la base creada (volumen pgdata), usa la misma clave con la que se creó:
# PostgreSQL solo toma POSTGRES_PASSWORD la primera vez que inicializa el volumen.
POSTGRES_USER=reservas
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=reservas
